@model PagedList<ScheduleRow>
@{
    ViewData["Title"] = "Avisos";
    ViewData["NewLabel"] = "Nuevo aviso";
    var q = Model.Query;
}
<p class="text-muted">Los avisos vigentes aparecen en la franja amarilla del portal.</p>
<partial name="Admin/_SearchBar" model="q" view-data="ViewData" />

<div class="admin-card p-0 table-responsive">
    <table class="table admin-table table-hover">
        <thead>
            <tr>
                <partial name="Admin/_SortHeader" model='new SortHeader(q, "title", "Título")' />
                <th scope="col">Contenido</th>
                <partial name="Admin/_SortHeader" model='new SortHeader(q, "start", "Inicio")' />
                <th scope="col">Fin</th>
                <th scope="col">Estado</th>
                <th scope="col"><span class="visually-hidden">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Items)
            {
                <tr>
                    <td class="fw-semibold">@row.Title</td>
                    <td class="text-truncate" style="max-width: 360px">@row.Detail</td>
                    <td><local-time value="row.StartDate" /></td>
                    <td><local-time value="row.EndDate" /></td>
                    <td><partial name="Admin/_ScheduleBadge" model="row.Status" /></td>
                    <partial name="Admin/_RowActions" model="(row.Id, row.Available)" />
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-1" aria-hidden="true"></i>Sin registros.</td></tr>
            }
        </tbody>
    </table>
</div>
<partial name="Admin/_Pager" model="(q, Model.TotalPages, Model.TotalCount)" />
