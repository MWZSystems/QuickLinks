@model AdviceForm
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo aviso" : "Editar aviso";
    var settings = await SettingsService.GetAsync();
}
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? null : Model.Id)" method="post" class="admin-card form-section">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Content" class="form-label"></label>
            <textarea asp-for="Content" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Content" class="text-danger small"></span>
        </div>
        <partial name="Admin/_ScheduleFields" model="Model" />
    </div>
    <p class="form-text mt-3">Horario en la zona @settings.TimeZone.Id.</p>
    <div class="form-actions">
        <partial name="Admin/_FormActions" />
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
