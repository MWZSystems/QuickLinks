@model CategoryForm
@{
    ViewData["Title"] = Model.Id == 0 ? "Nueva categoría" : "Editar categoría";
}
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@(Model.Id == 0 ? null : Model.Id)" method="post" class="admin-card form-section">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Color" class="form-label"></label>
            <div class="input-group">
                <input type="color" class="form-control form-control-color" value="@Model.Color" data-color-input="#Color" aria-label="Selector de color" />
                <input asp-for="Color" class="form-control" />
            </div>
            <span asp-validation-for="Color" class="text-danger small"></span>
        </div>
        <div class="col-12 form-check form-switch ms-2">
            <input asp-for="Available" class="form-check-input" role="switch" />
            <label asp-for="Available" class="form-check-label"></label>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-brand px-4">Guardar</button>
        <a asp-action="Index" class="btn btn-light border">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
