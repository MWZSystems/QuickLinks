@model IReadOnlyList<SettingsOverviewItem>
@{
    ViewData["Title"] = "Configuración";
}
<p class="text-muted">Elige un apartado para personalizar el portal de este cliente. Los cambios se aplican de inmediato en todas las páginas.</p>

<div class="settings-grid">
    @foreach (var item in Model)
    {
        <a class="settings-card" asp-action="@item.Section.Action">
            <div class="settings-card-head">
                <span class="settings-card-icon"><i class="bi @item.Section.Icon" aria-hidden="true"></i></span>
                <div>
                    <h2 class="settings-card-title">@item.Section.Title</h2>
                    <p class="settings-card-text">@item.Section.Description</p>
                </div>
            </div>
            <dl class="settings-summary">
                @foreach (var (label, value) in item.Summary)
                {
                    <div>
                        <dt>@label</dt>
                        <dd>@value</dd>
                    </div>
                }
            </dl>
            <span class="settings-card-action">Configurar <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
        </a>
    }
</div>
