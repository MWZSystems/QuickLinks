@model AppCard
<a href="@Model.Link" target="_blank" rel="noopener noreferrer"
   class="app-card app-link @(Model.IsBlocked ? "is-blocked" : "")"
   data-app-id="@Model.Id" data-app-name="@Model.Name">
    @* span y no button: un elemento interactivo no puede ir dentro de un enlace. *@
    <span class="app-card-more" role="button" tabindex="0" data-details="@Model.Id" aria-label="Ver detalle de @Model.Name" title="Ver detalle y fijar">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
    </span>
    @if (Model.ImageUrl is not null)
    {
        <img class="app-card-logo" src="@Model.ImageUrl" alt="" loading="lazy" />
        <span class="app-card-name">@Model.Name</span>
    }
    else
    {
        <i class="bi bi-window-stack app-card-placeholder" aria-hidden="true"></i>
        <span class="app-card-name app-card-name-only">@Model.Name</span>
    }
    @if (Model.IsBlocked)
    {
        <span class="app-card-badge"><i class="bi bi-tools me-1" aria-hidden="true"></i>En mantenimiento</span>
    }
</a>
