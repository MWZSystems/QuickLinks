@model PortalViewModel
@if (Model.Sections.Count == 0)
{
    <p class="empty-note mt-5">No hay aplicaciones que coincidan con los filtros seleccionados.</p>
}
@foreach (var block in Model.Sections)
{
    <section class="app-section">
        <h2 class="section-divider" style="--section-color: @Branding.SafeColor(block.Color)">
            <span>@block.Title</span>
        </h2>
        <div class="app-grid">
            @foreach (var app in block.Apps)
            {
                <partial name="_AppCard" model="app" />
            }
        </div>
    </section>
}
