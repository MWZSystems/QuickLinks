@model PortalViewModel
@{
    ViewData["Title"] = "Inicio";
    var filter = Model.Filter;
    var filtersOpen = filter.CategoryIds.Count > 0 || filter.HasLocationOrGroup;
}

@if (Model.Notices.Count > 0)
{
    <div class="news-ticker" role="region" aria-label="Avisos">
        <span class="news-label"><i class="bi bi-megaphone-fill me-1" aria-hidden="true"></i> Avisos</span>
        <div class="news-track">
            <div class="news-items">
                @foreach (var notice in Model.Notices)
                {
                    <span class="news-item">@notice</span>
                }
            </div>
        </div>
    </div>
}

<div id="portal"
     data-results-url="@Url.Action("Results", "Home")"
     data-details-url="@Url.Action("Details", "Home")"
     data-maintenance-url="@Url.Action("Maintenance", "Home")"
     data-placeholder="@Url.Content("~/images/placeholder.svg")">

    <form id="portal-form" method="get" asp-action="Index" class="portal-form" autocomplete="off">
        <div class="portal-toolbar">
            <div class="search-box">
                <i class="bi bi-search search-icon" aria-hidden="true"></i>
                <input type="search" class="form-control search-input" name="Search" value="@filter.Search"
                       placeholder="Buscar aplicación..." aria-label="Buscar aplicación" data-search autofocus />
            </div>
            <button type="button" class="btn btn-brand-outline" data-toggle-filters aria-expanded="@(filtersOpen ? "true" : "false")" aria-controls="filters-panel">
                <i class="bi bi-funnel me-1" aria-hidden="true"></i> Filtros
            </button>
            <span class="app-count"><i class="bi bi-grid-3x3-gap me-1" aria-hidden="true"></i><span id="app-count">@Model.AppCount</span> aplicaciones</span>
        </div>

        <div id="filters-panel" class="filters-panel" @(filtersOpen ? "" : "hidden")>
            <div class="filters-selects">
                <label>
                    <span><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>Sitio</span>
                    <select name="SiteId" class="form-select" data-filter data-site-select>
                        <option value="">Todos</option>
                        @foreach (var site in Model.Sites)
                        {
                            <option value="@site.Id" selected="@(filter.SiteId == site.Id)">@site.Name</option>
                        }
                    </select>
                </label>
                <label>
                    <span><i class="bi bi-building me-1" aria-hidden="true"></i>Edificio</span>
                    <select name="BuildingId" class="form-select" data-filter data-building-select>
                        <option value="">Todos</option>
                        @foreach (var building in Model.Buildings)
                        {
                            <option value="@building.Id" data-site="@building.ParentId" selected="@(filter.BuildingId == building.Id)">@building.Name</option>
                        }
                    </select>
                </label>
                <label>
                    <span><i class="bi bi-collection me-1" aria-hidden="true"></i>Grupo</span>
                    <select name="GroupId" class="form-select" data-filter>
                        <option value="">Ninguno</option>
                        @foreach (var group in Model.Groups)
                        {
                            <option value="@group.Id" selected="@(filter.GroupId == group.Id)">@group.Name</option>
                        }
                    </select>
                </label>
            </div>
            <div class="filters-chips" role="group" aria-label="Categorías">
                <button type="button" class="chip chip-clear" data-clear-filters><i class="bi bi-x-circle me-1" aria-hidden="true"></i>Limpiar</button>
                @foreach (var category in Model.Categories)
                {
                    <label class="chip">
                        <input type="checkbox" name="CategoryIds" value="@category.Id" data-filter
                               checked="@filter.CategoryIds.Contains(category.Id)" />
                        <span>@category.Name</span>
                    </label>
                }
            </div>
        </div>
    </form>

    @if (Model.Pinned.Count > 0 || Model.Recent.Count > 0)
    {
        <div class="quick-access">
            @if (Model.Pinned.Count > 0)
            {
                <section class="quick-row" aria-label="Fijadas">
                    <h2 class="quick-title"><i class="bi bi-pin-angle-fill" aria-hidden="true"></i>Fijadas</h2>
                    <ul class="app-pill-list app-pill-list-start">
                        @foreach (var app in Model.Pinned)
                        {
                            <partial name="_AppPill" model="app" view-data='new ViewDataDictionary(ViewData) { ["Variant"] = "solid", ["CanUnpin"] = true }' />
                        }
                    </ul>
                </section>
            }
            @if (Model.Recent.Count > 0)
            {
                <section class="quick-row" aria-label="Usadas recientemente">
                    <h2 class="quick-title"><i class="bi bi-clock-history" aria-hidden="true"></i>Recientes</h2>
                    <ul class="app-pill-list app-pill-list-start">
                        @foreach (var app in Model.Recent)
                        {
                            <partial name="_AppPill" model="app" />
                        }
                    </ul>
                </section>
            }
        </div>
    }

    <div id="complete-results"><partial name="_CompleteResults" model="Model" /></div>
</div>

<!-- Detalle de aplicación -->
<div class="modal fade" id="details-modal" tabindex="-1" aria-labelledby="details-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="details-title"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body details-body">
                <div id="details-carousel" class="carousel slide details-carousel" data-bs-ride="carousel">
                    <div class="carousel-indicators"></div>
                    <div class="carousel-inner"></div>
                </div>
                <dl class="details-info">
                    <dt><i class="bi bi-card-text me-2" aria-hidden="true"></i>Descripción</dt>
                    <dd data-field="description"></dd>
                    <dt><i class="bi bi-person-badge me-2" aria-hidden="true"></i>Responsable (SME)</dt>
                    <dd data-field="sme"></dd>
                    <dt><i class="bi bi-book me-2" aria-hidden="true"></i>Manual de usuario</dt>
                    <dd data-field="userManual"></dd>
                    <dt><i class="bi bi-tag me-2" aria-hidden="true"></i>Versión</dt>
                    <dd data-field="version"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-brand-outline" data-pin-toggle></button>
                <a href="#" class="btn btn-success ms-auto app-link" target="_blank" rel="noopener noreferrer" data-open-app><i class="bi bi-box-arrow-up-right me-2" aria-hidden="true"></i>Abrir aplicación</a>
            </div>
        </div>
    </div>
</div>

<!-- Aplicación en mantenimiento -->
<div class="modal fade" id="maintenance-modal" tabindex="-1" aria-labelledby="maintenance-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="maintenance-title"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <div class="maintenance-icon" aria-hidden="true"><i class="bi bi-tools"></i></div>
                <p class="mt-3 mb-0" data-maintenance-message></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-brand px-4" data-bs-dismiss="modal"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Entendido</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmación para quitar de fijadas -->
<div class="modal fade" id="unpin-modal" tabindex="-1" aria-labelledby="unpin-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="unpin-title"><i class="bi bi-pin-angle me-2" aria-hidden="true"></i>Quitar de fijadas</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">¿Quieres quitar esta aplicación de tus fijadas?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1" aria-hidden="true"></i>Cancelar</button>
                <button type="button" class="btn btn-danger" data-confirm-unpin><i class="bi bi-pin-angle me-1" aria-hidden="true"></i>Quitar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/portal.js" asp-append-version="true"></script>
}
