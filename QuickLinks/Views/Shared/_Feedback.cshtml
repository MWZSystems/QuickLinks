@{
    // Avisos emergentes: éxito, información, advertencia y error (Services/Feedback.cs). Los errores no se cierran solos.
    var messages = Feedback.Take(TempData);
    // Un formulario devuelto con datos inválidos también avisa; el detalle sigue junto a cada campo.
    // Los errores generales (sin campo, como «usuario o contraseña incorrectos») se muestran tal cual.
    if (!ViewData.ModelState.IsValid && messages.All(m => m.Kind != FeedbackKind.Error))
    {
        var general = ViewData.ModelState.Where(e => e.Key == "").SelectMany(e => e.Value!.Errors)
            .Select(e => e.ErrorMessage).Where(t => t != "").Distinct().ToList();
        messages.InsertRange(0, general.Count > 0
            ? general.Select(t => new FeedbackMessage(FeedbackKind.Error, t))
            : [new(FeedbackKind.Error, "Revisa los datos marcados en el formulario.")]);
    }
    (string Css, string Icon, string Title, int Timeout) Style(FeedbackKind kind) => kind switch
    {
        FeedbackKind.Success => ("toast-success", "bi-check-circle-fill", "Listo", 5000),
        FeedbackKind.Info => ("toast-info", "bi-info-circle-fill", "Información", 7000),
        FeedbackKind.Warning => ("toast-warning", "bi-exclamation-triangle-fill", "Atención", 9000),
        _ => ("toast-error", "bi-x-circle-fill", "Error", 0)
    };
}
<div class="toast-stack" id="toast-stack" aria-live="polite" aria-atomic="false">
    @foreach (var m in messages)
    {
        var s = Style(m.Kind);
        <div class="app-toast @s.Css" role="@(m.Kind is FeedbackKind.Error or FeedbackKind.Warning ? "alert" : "status")" data-timeout="@s.Timeout">
            <i class="bi @s.Icon app-toast-icon" aria-hidden="true"></i>
            <div class="app-toast-body">
                <div class="app-toast-title">@s.Title</div>
                <div>@m.Text</div>
            </div>
            <button type="button" class="app-toast-close" aria-label="Cerrar aviso"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }
</div>
