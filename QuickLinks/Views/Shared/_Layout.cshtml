@{
    var settings = await SettingsService.GetAsync();
    var footer = string.IsNullOrWhiteSpace(settings.CompanyName)
        ? settings.AppName
        : $"{settings.CompanyName} · {settings.AppName}";
}
<!DOCTYPE html>
<html lang="es" style="--ql-primary: @Branding.SafeColor(settings.PrimaryColor)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @settings.AppName</title>
    <partial name="_Favicon" model="settings" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
</head>
<body class="portal" data-base-url="@Url.Content("~/")">
    <header>
        <nav class="navbar navbar-expand-sm bg-white border-bottom px-3 px-lg-5">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <partial name="_Brand" model="settings" />
                </a>
                @* Acceso de administradores discreto: los usuarios del portal no necesitan iniciar sesión. *@
                <div class="ms-auto dropdown">
                    <button type="button" class="btn btn-admin-menu" data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="Opciones" title="Opciones">
                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li><h6 class="dropdown-header"><i class="bi bi-person-circle me-1" aria-hidden="true"></i>@User.Identity.Name</h6></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Applications" asp-action="Index">
                                    <i class="bi bi-gear me-2" aria-hidden="true"></i>Administración
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li><h6 class="dropdown-header">Solo para administradores</h6></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Iniciar sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="portal-footer">
        <div class="container text-center">@footer @AppInfo.Version</div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
