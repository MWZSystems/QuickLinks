@model PortalSettings
@* Logo del cliente si está configurado; si no, el nombre de la aplicación con un ícono neutro. *@
@if (Model.LogoUrl is not null)
{
    <img src="@Model.LogoUrl" alt="@Model.AppName" class="brand-logo" />
}
else
{
    <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
            <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
        </svg>
    </span>
    <span class="brand-name">@Model.AppName</span>
}
