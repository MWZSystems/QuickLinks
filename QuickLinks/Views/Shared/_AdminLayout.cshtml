@* Administración: estructura común de MWZSystem.Ui con el menú de catálogos. *@
@{
    var settings = await SettingsService.GetAsync();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var menu = new (string Controller, string Label, string Icon, string Hint)[]
    {
        ("Summary", "Resumen", "speedometer2", "Totales del portal en este momento"),
        ("Applications", "Aplicaciones", "window-stack", "Enlaces que aparecen en el portal"),
        ("Categories", "Categorías", "tags", "Secciones de colores del portal"),
        ("Groups", "Grupos", "collection", "Agrupaciones que cruzan categorías"),
        ("Sites", "Sitios", "geo-alt", "Plantas o ubicaciones"),
        ("Buildings", "Edificios", "building", "Edificios de cada sitio"),
        ("Advices", "Avisos", "megaphone", "Mensajes de la franja de avisos"),
        ("Maintenances", "Mantenimientos", "tools", "Ventanas que bloquean una aplicación"),
        ("Users", "Usuarios", "people", "Quién puede administrar"),
        ("Settings", "Configuración", "gear", "Marca, portal, avisos, seguridad, imágenes y regional")
    };
    var current = menu.FirstOrDefault(m => m.Controller == controller);
    var pageTitle = ViewData["Title"] as string;

    var items = menu.Select(m => new MwzMenuItem(m.Label, Url.Action("Index", m.Controller)!, m.Icon, m.Controller == controller)
    {
        Hint = m.Hint,
        // Las secciones de configuración solo se despliegan mientras se está en Configuración.
        Children = m.Controller == "Settings" && controller == "Settings"
            ? SettingsSection.All
                .Select(p => new MwzMenuItem(p.Title, Url.Action(p.Action, "Settings")!, p.Icon.Replace("bi-", ""), p.Action == action))
                .ToList()
            : []
    }).ToList();
    items.Add(new("Ir al portal", Url.Action("Index", "Home")!, "house") { SeparatorBefore = true });
    items.Add(new("Guía de uso", "~/docs/QuickLinks-Guia-de-uso.pptx", "file-earmark-slides")
    {
        Download = true,
        Hint = "Presentación con capturas para usuarios y administradores"
    });

    ViewData[MwzShell.ViewDataKey] = new MwzShell
    {
        AppName = settings.AppName,
        Theme = "quicklinks",
        PrimaryColor = Branding.SafeColor(settings.PrimaryColor),
        HomeUrl = Url.Action("Index", "Home")!,
        Menu = items,
        UserName = User.Identity?.Name,
        LogoutUrl = Url.Action("Logout", "Account"),
        LoginUrl = Url.Action("Login", "Account"),
        Footer = $"{settings.AppName} · Versión {AppInfo.Version}",
        Notices = Feedback.ToNotices(TempData, ViewData.ModelState),
        BodyClass = "admin"
    };
    ViewData["Title"] = $"{pageTitle} - Administración";
    Layout = MwzShell.Layout;
}
@section Head {
    <partial name="_Favicon" model="settings" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
@section Brand {
    <partial name="_Brand" model="settings" />
}
@section Topbar {
    <span class="admin-tag d-none d-sm-inline"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Administración</span>
}
<h1 class="admin-title">
    @if (current.Icon is not null)
    {
        <i class="bi bi-@current.Icon" aria-hidden="true"></i>
    }
    @pageTitle
</h1>
@if (current.Hint is not null)
{
    <p class="admin-subtitle">@current.Hint</p>
}
@RenderBody()
@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
