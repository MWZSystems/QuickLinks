@model string
@{
    var (css, icon) = Model switch
    {
        "Vigente" => ("text-bg-success", "bi-broadcast"),
        "Programado" => ("text-bg-info", "bi-calendar-event"),
        "Vencido" => ("text-bg-light border", "bi-calendar-x"),
        _ => ("text-bg-secondary", "bi-slash-circle")
    };
}
<span class="badge @css"><i class="bi @icon me-1" aria-hidden="true"></i>@Model</span>
