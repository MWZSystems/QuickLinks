@model bool
<td>
    @if (Model)
    {
        <span class="badge text-bg-success"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>Activo</span>
    }
    else
    {
        <span class="badge text-bg-secondary"><i class="bi bi-slash-circle me-1" aria-hidden="true"></i>Inactivo</span>
    }
</td>
